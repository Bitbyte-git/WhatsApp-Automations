# Node & Frontend
node_modules/
/frontend/node_modules/
/frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

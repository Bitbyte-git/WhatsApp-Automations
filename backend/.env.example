# BitByte WhatsApp SaaS - Backend Environment Configuration

# Database: Neon PostgreSQL URL (e.g., postgresql://username:password@ep-bitbyte-xxxx.ap-southeast-1.neon.tech/bitbyte_whatsapp?sslmode=require)
DATABASE_URL=

# Django Security
DJANGO_SECRET_KEY=bitbyte-whatsapp-saas-production-key-change-in-prod-xyz789
DEBUG=True
ALLOWED_HOSTS=*

# Meta WhatsApp Cloud API Credentials
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=bitbyte_whatsapp_webhook_token_secure
META_GRAPH_API_VERSION=v21.0
META_SYSTEM_USER_TOKEN=

# OpenRouter / AI Chatbot Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5174
